# --- Home Assistant connection ---
# When running as a Home Assistant add-on these can be left blank; the add-on
# automatically talks to HA through the Supervisor proxy using SUPERVISOR_TOKEN.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace_with_a_long_lived_access_token

# --- Entities used for watering adjustments ---
HA_WEATHER_ENTITY=weather.home
HA_OUTDOOR_TEMP_ENTITY=sensor.outdoor_temperature
HA_INDOOR_TEMP_ENTITY=sensor.indoor_temperature
# Optional rain gauge (mm in the recent period), leave blank if none:
HA_RAIN_ENTITY=

# --- Notifications ---
# Any Home Assistant notify services, comma separated:
NOTIFY_SERVICES=notify.mobile_app_your_phone
# Optional email fallback:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
EMAIL_TO=

# --- Scheduling ---
NOTIFY_TIME=08:00
TZ=Europe/Madrid
# Months (1-12) during which fertilizing reminders are sent (spring/summer):
FERTILIZE_MONTHS=3,4,5,6,7,8

# --- Pl@ntNet plant identification (https://my.plantnet.org) ---
# Leave blank to disable; the key can also be set in the app's Settings screen.
PLANTNET_API_KEY=
# "all" for the global flora, or a specific project such as "k-southwestern-europe"
PLANTNET_PROJECT=all
PLANTNET_LANG=en

# --- Server ---
HOST=0.0.0.0
PORT=8099
