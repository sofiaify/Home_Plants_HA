# Copy this file to `.deploy.env` and fill it in. It is git-ignored.

# --- SSH access to the Home Assistant device ---------------------------------
# Hostname or IP of the HA box (the Raspberry Pi).
HA_HOST=homeassistant.local
# SSH port exposed by the "Advanced SSH & Web Terminal" add-on.
HA_SSH_PORT=22
# SSH user (root for the Advanced SSH & Web Terminal add-on).
HA_SSH_USER=root
# /addons is root-owned. If your SSH user isn't root, deploy.sh can use sudo:
#   auto = use sudo only if needed and passwordless (default)
#   1    = always use sudo
#   0    = never use sudo
REMOTE_SUDO=auto

# --- Where add-ons live / naming --------------------------------------------
# Local add-ons are read from here by Home Assistant OS.
ADDONS_PATH=/addons
# Folder name created under ADDONS_PATH.
ADDON_DIR_NAME=plants
# Home Assistant prefixes local add-ons with "local_".
ADDON_SLUG=local_plants

# --- Data --------------------------------------------------------------------
# 1 = bundle your current data/plants.db + photos so the device starts with your
#     existing plants, rooms and settings. 0 = start fresh from the seed photos.
CARRY_DATA=1

# --- Optional auto-reload via the Home Assistant API -------------------------
# If both are set, deploy.sh will reload the store and rebuild/restart the add-on.
# Create a long-lived token in your HA profile.
# HA_API_URL=http://homeassistant.local:8123
# HA_TOKEN=
